---
export interface ShortcutPlannerOption {
  id: string;
  label: string;
  phrase: string;
  note: string;
}

export interface ShortcutPlannerGroup {
  id: string;
  label: string;
  title: string;
  options: ShortcutPlannerOption[];
}

interface Props {
  ariaLabel: string;
  summaryLabel: string;
  noteLabel: string;
  linkLabel: string;
  groups: ShortcutPlannerGroup[];
}

const { ariaLabel, summaryLabel, noteLabel, linkLabel, groups } = Astro.props;
const defaults = groups.map((group) => group.options[0]);
const defaultSummary = defaults.map((option) => option.phrase).join('');
const defaultNotes = defaults.map((option) => option.note).join(' ');
---

<div class="shortcut-planner" data-shortcut-planner>
  <div class="shortcut-planner-groups" role="group" aria-label={ariaLabel}>
    {groups.map((group, groupIndex) => (
      <fieldset data-shortcut-group={group.id}>
        <legend>{String(groupIndex + 1).padStart(2, '0')} / {group.label}</legend>
        <strong>{group.title}</strong>
        <div class="shortcut-planner-options">
          {group.options.map((option, optionIndex) => (
            <button
              type="button"
              aria-pressed={optionIndex === 0 ? 'true' : 'false'}
              tabindex={optionIndex === 0 ? 0 : -1}
              data-shortcut-option={option.id}
              data-shortcut-phrase={option.phrase}
              data-shortcut-note={option.note}
            >
              <i>{String(optionIndex + 1).padStart(2, '0')}</i>
              <span>{option.label}</span>
            </button>
          ))}
        </div>
      </fieldset>
    ))}
  </div>

  <div class="shortcut-planner-result" data-shortcut-result aria-live="polite" aria-atomic="true">
    <div>
      <span>{summaryLabel}</span>
      <strong data-shortcut-summary>{defaultSummary}</strong>
    </div>
    <aside>
      <span>{noteLabel}</span>
      <p data-shortcut-notes>{defaultNotes}</p>
      <a href="#actions"><span>{linkLabel}</span><i aria-hidden="true">→</i></a>
    </aside>
  </div>
</div>

<script>
  import '../../scripts/shortcutPlanner';
</script>

<style is:global>
  .shortcut-planner { margin-top: clamp(58px, 8vw, 96px); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .shortcut-planner-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .shortcut-planner fieldset { min-width: 0; min-height: 420px; margin: 0; padding: 24px 28px 28px; display: flex; flex-direction: column; border: 0; border-right: 1px solid var(--line); }
  .shortcut-planner fieldset:first-child { padding-left: 0; }
  .shortcut-planner fieldset:last-child { padding-right: 0; border-right: 0; }
  .shortcut-planner legend { width: 100%; padding: 0; color: var(--blue); font: 9px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .shortcut-planner fieldset > strong { margin-top: 42px; font-family: "Iowan Old Style", "Songti SC", Georgia, serif; font-size: clamp(23px, 2.2vw, 30px); font-weight: 400; line-height: 1.2; }
  .shortcut-planner-options { margin-top: auto; padding-top: 38px; }
  .shortcut-planner-options button { position: relative; width: 100%; min-height: 48px; padding: 12px 2px; display: grid; grid-template-columns: 28px minmax(0, 1fr) 12px; gap: 9px; align-items: center; border: 0; border-top: 1px solid var(--line); border-radius: 0; color: var(--muted); background: transparent; font: 13px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-align: left; cursor: pointer; transition: color .22s ease, background-color .22s ease; }
  .shortcut-planner-options button:last-child { border-bottom: 1px solid var(--line); }
  .shortcut-planner-options button::after { content: ""; width: 7px; height: 7px; border: 1px solid currentColor; border-radius: 50%; }
  .shortcut-planner-options button:hover,
  .shortcut-planner-options button:focus-visible { color: var(--ink); background: var(--surface-hover); }
  .shortcut-planner-options button:focus-visible { outline: 2px solid var(--blue); outline-offset: -3px; }
  .shortcut-planner-options button[aria-pressed="true"] { color: var(--ink); }
  .shortcut-planner-options button[aria-pressed="true"]::after { border-color: var(--blue); background: var(--blue); }
  .shortcut-planner-options button i { color: var(--blue); font: normal 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .shortcut-planner-result { min-height: 270px; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr); border-top: 1px solid var(--line); }
  .shortcut-planner-result > div { padding: 32px clamp(32px, 5vw, 72px) 38px 0; display: flex; flex-direction: column; }
  .shortcut-planner-result > div > span,
  .shortcut-planner-result aside > span { color: var(--blue); font: 9px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .shortcut-planner-result strong { max-width: 760px; margin-top: 42px; font-family: "Iowan Old Style", "Songti SC", Georgia, serif; font-size: clamp(25px, 2.8vw, 39px); font-weight: 400; line-height: 1.3; text-wrap: balance; }
  .shortcut-planner-result aside { padding: 32px 0 32px clamp(28px, 4vw, 56px); display: flex; flex-direction: column; border-left: 1px solid var(--line); }
  .shortcut-planner-result aside p { margin: 38px 0 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
  .shortcut-planner-result aside a { min-height: 44px; margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--ink); font-size: 12px; }
  .shortcut-planner-result aside a i { font-style: normal; transition: transform .25s var(--ease); }
  .shortcut-planner-result aside a:hover i,
  .shortcut-planner-result aside a:focus-visible i { transform: translateX(4px); }
  .shortcut-planner-result.is-updating > * { animation: shortcut-planner-in .3s var(--ease) both; }
  @keyframes shortcut-planner-in { from { opacity: .32; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 820px) {
    .shortcut-planner-groups { grid-template-columns: 1fr; }
    .shortcut-planner fieldset,
    .shortcut-planner fieldset:first-child,
    .shortcut-planner fieldset:last-child { min-height: 0; padding: 24px 0 30px; border-right: 0; border-bottom: 1px solid var(--line); }
    .shortcut-planner fieldset:last-child { border-bottom: 0; }
    .shortcut-planner fieldset > strong { margin-top: 28px; }
    .shortcut-planner-options { margin-top: 34px; padding-top: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
    .shortcut-planner-options button { min-height: 54px; padding-inline: 12px; border-bottom: 0; border-right: 1px solid var(--line); }
    .shortcut-planner-options button:nth-child(odd) { padding-left: 0; }
    .shortcut-planner-options button:nth-child(even) { padding-right: 0; border-right: 0; }
    .shortcut-planner-result { grid-template-columns: 1fr; }
    .shortcut-planner-result > div { min-height: 245px; padding-right: 0; }
    .shortcut-planner-result aside { min-height: 200px; padding: 28px 0 26px; border-top: 1px solid var(--line); border-left: 0; }
    .shortcut-planner-result aside p { max-width: 620px; margin-top: 28px; }
  }

  @media (max-width: 560px) {
    .shortcut-planner { margin-top: 50px; }
    .shortcut-planner fieldset > strong { font-size: 26px; }
    .shortcut-planner-options button { min-height: 58px; grid-template-columns: 24px minmax(0, 1fr) 10px; gap: 7px; font-size: 12px; }
    .shortcut-planner-result > div { min-height: 280px; padding: 28px 0 31px; }
    .shortcut-planner-result strong { margin-top: 34px; font-size: 29px; }
    .shortcut-planner-result aside { min-height: 210px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shortcut-planner-options button,
    .shortcut-planner-result aside a i { transition: none; }
    .shortcut-planner-result.is-updating > * { animation: none; }
  }

  @media print {
    .shortcut-planner-options { display: none !important; }
    .shortcut-planner fieldset { min-height: 24mm; padding-block: 4mm; }
    .shortcut-planner-result { min-height: 0; }
  }
</style>
