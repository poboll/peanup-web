---
import type { Locale } from '../i18n/product';

interface Props {
  locale?: Locale;
}

const { locale = 'zh-cn' } = Astro.props;
const labels = {
  'zh-cn': { dark: '切换到深色模式', light: '切换到浅色模式' },
  'zh-tw': { dark: '切換到深色模式', light: '切換到淺色模式' },
  en: { dark: 'Switch to dark mode', light: 'Switch to light mode' },
  ja: { dark: 'ダークモードに切り替える', light: 'ライトモードに切り替える' },
  de: { dark: 'Zum dunklen Modus wechseln', light: 'Zum hellen Modus wechseln' },
  fr: { dark: 'Passer au mode sombre', light: 'Passer au mode clair' },
} satisfies Record<Locale, { dark: string; light: string }>;

const label = labels[locale];
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-dark={label.dark}
  data-label-light={label.light}
  aria-label={label.dark}
  aria-pressed="false"
  title={label.dark}
>
  <span class="theme-toggle-track" aria-hidden="true">
    <svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 20 20">
      <circle cx="10" cy="10" r="3.1"></circle>
      <path d="M10 2.2v1.6M10 16.2v1.6M2.2 10h1.6M16.2 10h1.6M4.5 4.5l1.1 1.1M14.4 14.4l1.1 1.1M15.5 4.5l-1.1 1.1M5.6 14.4l-1.1 1.1"></path>
    </svg>
    <svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 20 20">
      <path d="M15.9 12.4A6.2 6.2 0 0 1 7.6 4.1a6.3 6.3 0 1 0 8.3 8.3Z"></path>
    </svg>
    <span class="theme-toggle-thumb"></span>
  </span>
</button>
