                </header>
                <div class="phone-view-stack">
                  <section id="phone-view-compose" class="phone-view phone-compose is-active" data-phone-view="compose" role="tabpanel" aria-labelledby="phone-state-compose" aria-hidden="false">
                    <header class="phone-view-title"><span>ON DEVICE</span><strong>{copy.ecosystem.features[2].title}</strong></header>
                    <div class="phone-compose-card">
                      <div class="phone-compose-art" aria-hidden="true"><i></i><i></i><i></i><i></i><span>{copy.content.modes[0].meta}</span></div>
                      <strong>{copy.content.modes[0].title}</strong>
                      <div class="phone-pigment-track" aria-hidden="true">{paletteValues.map((color) => <i style={`--phone-pigment:${color}`}></i>)}</div>
                    </div>
                    <div class="phone-source-list" aria-label={copy.content.modesLabel}>
                      {copy.content.modes.map((mode, index) => <span class:list={{ active: index === 0 }}><i>{String(index + 1).padStart(2, '0')}</i>{mode.label}</span>)}
                    </div>
                  </section>

                  <section id="phone-view-library" class="phone-view phone-library" data-phone-view="library" role="tabpanel" aria-labelledby="phone-state-library" aria-hidden="true">
                    <header class="phone-view-title"><span>CONTENT</span><strong>{copy.content.modesLabel}</strong></header>
                    <div class="phone-library-grid">
                      {copy.content.modes.map((mode, index) => (
                        <article class={`phone-library-card phone-library-card--${mode.id}`}>
                          <div class="phone-library-art" aria-hidden="true"><i></i></div>
                          <span>{String(index + 1).padStart(2, '0')} / {mode.label}</span>
                          <strong>{mode.title}</strong>
                        </article>
                      ))}
                    </div>
                  </section>

                  <section id="phone-view-automate" class="phone-view phone-automate" data-phone-view="automate" role="tabpanel" aria-labelledby="phone-state-automate" aria-hidden="true">
                    <header class="phone-view-title"><span>SHORTCUTS</span><strong>{copy.ecosystem.features[0].title}</strong></header>
                    <section class="peanup-shortcut-card">
                      <header><span>AUTOMATION</span><strong>{copy.ecosystem.features[0].title}</strong></header>
                      <ol>
                        {copy.ecosystem.flow.map((item, index) => (
                          <li class:list={{ 'is-done': index < 2, 'is-current': index === 2 }}>
                            <i>{String(index + 1).padStart(2, '0')}</i><span>{item}</span><b aria-hidden="true"></b>
                          </li>
                        ))}
                      </ol>
                    </section>
                    <div class="peanup-next-update">
                      <div><span>NEXT FRAME</span><strong data-automation-frame-title>{copy.ecosystem.automation.moments[0].title}</strong></div>
                      <b data-automation-frame-time>{copy.ecosystem.automation.moments[0].time}</b>
                      <div class="peanup-frame-queue" aria-hidden="true"><i></i><i></i><i></i></div>
                    </div>
                  </section>

                  <section id="phone-view-transfer" class="phone-view phone-transfer" data-phone-view="transfer" role="tabpanel" aria-labelledby="phone-state-transfer" aria-hidden="true">
                    <header class="phone-view-title"><span>NEARBY UPDATE</span><strong>{copy.ecosystem.features[1].title}</strong></header>
                    <section class="peanup-live-activity">
                      <div class="peanup-live-head"><span>LIVE ACTIVITY</span><b>68%</b></div>
                      <div class="peanup-live-body">
                        <div class="peanup-live-preview" aria-hidden="true"><i></i><b></b><span></span></div>
                        <div class="peanup-live-copy">
                          <small>E-PAPER UPDATE</small>
                          <strong>{copy.ecosystem.features[1].title}</strong>
                          <span class="peanup-live-progress"><i></i></span>
                        </div>
                      </div>
                    </section>
                    <ol class="peanup-transfer-list">
                      {copy.content.workflow.map((step, index) => (
                        <li class:list={{ 'is-done': index < 2, 'is-current': index === 2 }}><i>{String(index + 1).padStart(2, '0')}</i><span><strong>{step.title}</strong><small>{step.body}</small></span><b aria-hidden="true"></b></li>
                      ))}
                    </ol>
                    <div class="peanup-nearby-device" aria-hidden="true">
                      <div><i></i><span>PEANUP</span></div><b>FRAME 068 / 100</b><small>BLE · NEARBY</small>
                    </div>
                  </section>
                </div>
                <div class="peanup-app-footer"><span>LOCAL PROCESSING</span><b>E6 / SIX COLOR</b></div>
              </div>
              <i class="home-indicator" aria-hidden="true"></i>
            </div>
            <img
              class="iphone-frame protected-media"
              src="/assets/iphone-17-pro-frame.png"
              width="662"
              height="1380"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              draggable="false"
              alt=""
              aria-hidden="true"
            />
