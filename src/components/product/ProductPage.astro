---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HardwareIcon from '../HardwareIcon.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { getLocaleAlternates, localeMeta, localeOrder, type ProductCopy } from '../../i18n/product';
import '../../styles/global.css';

interface Props { copy: ProductCopy }

const { copy } = Astro.props;
const currentLocale = localeMeta[copy.locale];
const isChineseLocale = copy.locale === 'zh-cn' || copy.locale === 'zh-tw';
const heroBrandPrimary = isChineseLocale ? '花生片' : 'Peanup';
const heroBrandSecondary = isChineseLocale ? 'Peanup' : '';
const docsPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/' : '/en/docs/';
const contentPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/content/' : '/en/docs/content/';
const hardwarePath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/hardware/' : '/en/docs/hardware/';
const troubleshootingPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/troubleshooting/' : '/en/docs/troubleshooting/';
const supportPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/support/' : '/en/docs/support/';
const campaignPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/campaign/' : '/en/docs/campaign/';
const engineeringPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/engineering/' : '/en/docs/engineering/';
const privacyPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/privacy/' : '/en/docs/privacy/';
const shortcutsPath = copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? '/docs/shortcuts/' : '/en/docs/shortcuts/';
const specificationEvidencePaths = [`${docsPath}#specifications`, `${campaignPath}#targets`, `${campaignPath}#before-pledge`];
const detectLocale = Astro.url.pathname === '/';
const isLegacyLocaleAlias = Astro.url.pathname === '/zh-cn/';
const hardwareIcons = ['bluetooth', 'nfc', 'battery', 'magnet'] as const;
const paletteValues = ['#20211f', '#eeeee8', '#b5473b', '#d5ae35', '#496fa7', '#668468'];
const phoneStates = [
  { id: 'compose', label: '01 / LOCAL', feature: copy.ecosystem.features[2] },
  { id: 'library', label: '02 / CONTENT', feature: { title: copy.content.modesLabel, body: copy.content.body } },
  { id: 'automate', label: '03 / SHORTCUTS', feature: copy.ecosystem.features[0] },
  { id: 'transfer', label: '04 / TRANSFER', feature: copy.ecosystem.features[1] },
] as const;
const phoneMobileTitles = {
  'zh-cn': ['本地处理', '内容模式', '快捷指令', '传输进度'],
  'zh-tw': ['本機處理', '內容模式', '捷徑', '傳輸進度'],
  en: ['On device', 'Content', 'Shortcuts', 'Transfer'],
  ja: ['端末内処理', 'コンテンツ', 'ショートカット', '転送'],
  de: ['Lokal', 'Inhalte', 'Kurzbefehle', 'Transfer'],
  fr: ['Sur appareil', 'Contenus', 'Raccourcis', 'Transfert'],
}[copy.locale];
const playNavLabel = {
  'zh-cn': '玩法',
  'zh-tw': '玩法',
  en: 'Ideas',
  ja: '使い方',
  de: 'Inhalte',
  fr: 'Usages',
}[copy.locale];
const platformFeatures = copy.ecosystem.features.slice(3);
const troubleshootingLabel = {
  'zh-cn': '使用帮助',
  'zh-tw': '使用說明',
  en: 'Help',
  ja: 'サポート',
  de: 'Hilfe',
  fr: 'Aide',
}[copy.locale];
const mobileDocsLabel = {
  'zh-cn': '文档',
  'zh-tw': '文件',
  en: 'Docs',
  ja: '文書',
  de: 'Docs',
  fr: 'Docs',
}[copy.locale];
const mobileLocaleLabel = {
  'zh-cn': '中文',
  'zh-tw': '繁中',
  en: 'EN',
  ja: '日本語',
  de: 'DE',
  fr: 'FR',
}[copy.locale];
const specificationDocLabel = {
  'zh-cn': '查看完整规格与证据口径',
  'zh-tw': '查看完整規格與證據口徑',
  en: 'Read full specifications and evidence',
  ja: '仕様と根拠を詳しく見る',
  de: 'Vollständige Spezifikationen und Nachweise',
  fr: 'Voir les spécifications et leurs sources',
}[copy.locale];
const technologyChapters = {
  'zh-cn': ['图像处理', '六色算法', '硬件能力', '目标规格'],
  'zh-tw': ['圖像處理', '六色演算法', '硬體能力', '目標規格'],
  en: ['Image path', 'Six-color rendering', 'Hardware', 'Specifications'],
  ja: ['画像処理', '6色レンダリング', 'ハードウェア', '仕様'],
  de: ['Bildpfad', 'Sechsfarb-Rendering', 'Hardware', 'Spezifikationen'],
  fr: ['Traitement', 'Rendu six couleurs', 'Matériel', 'Caractéristiques'],
}[copy.locale];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={copy.locale}
  htmlLang={currentLocale.htmlLang}
  ogLocale={currentLocale.ogLocale}
  canonicalPath={currentLocale.path}
  alternates={getLocaleAlternates()}
  schemaType="Product"
  robots={isLegacyLocaleAlias ? 'noindex,follow,noimageindex,max-image-preview:none' : 'index,follow,noimageindex,max-image-preview:none'}
  backTopLabel={copy.footer.backTop}
>
  {detectLocale && (
    <script is:inline>
      (() => {
        const preferenceKey = 'peanup.locale';
        const paths = {
          'zh-cn': '/',
          en: '/en/',
          'zh-tw': '/zh-tw/',
          ja: '/ja/',
          de: '/de/',
          fr: '/fr/',
        };

        const normalizeLocale = (language) => {
          if (!language) return null;
          const normalized = language.toLowerCase().replaceAll('_', '-');
          if (normalized === 'zh-tw' || normalized === 'zh-hk' || normalized === 'zh-mo' || normalized.startsWith('zh-hant')) return 'zh-tw';
          if (normalized === 'zh' || normalized === 'zh-cn' || normalized === 'zh-sg' || normalized.startsWith('zh-hans')) return 'zh-cn';
          const primary = normalized.split('-')[0];
          return primary === 'en' || primary === 'ja' || primary === 'de' || primary === 'fr' ? primary : null;
        };

        let locale = null;
        try {
          const preference = localStorage.getItem(preferenceKey);
          if (preference && Object.hasOwn(paths, preference)) {
            locale = preference;
          }
        } catch {}

        if (!locale) {
          let timeZone = '';
          try {
            timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          } catch {}
          const timeZoneLocales = {
            'Asia/Shanghai': 'zh-cn',
            'Asia/Chongqing': 'zh-cn',
            'Asia/Harbin': 'zh-cn',
            'Asia/Urumqi': 'zh-cn',
            'Asia/Taipei': 'zh-tw',
            'Asia/Hong_Kong': 'zh-tw',
            'Asia/Macau': 'zh-tw',
            'Asia/Tokyo': 'ja',
            'Europe/Berlin': 'de',
            'Europe/Busingen': 'de',
            'Europe/Vienna': 'de',
            'Europe/Paris': 'fr',
            'Europe/Monaco': 'fr',
          };
          locale = timeZoneLocales[timeZone] || null;

          if (!locale && !timeZone) {
            const utcOffset = -new Date().getTimezoneOffset();
            if (utcOffset === 480) locale = 'zh-cn';
            else if (utcOffset === 540) locale = 'ja';
          }
        }

        if (!locale) {
          const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
          for (const language of languages) {
            locale = normalizeLocale(language);
            if (locale) break;
          }
        }

        const target = paths[locale] || '/';
        if (target !== location.pathname) {
          location.replace(`${target}${location.search}${location.hash}`);
          return;
        }
        document.documentElement.dataset.suggestedLocale = locale || 'zh-cn';
      })();
    </script>
  )}
  <header class="site-header" aria-label={copy.nav.product}>
    <a class="brand" href={`${currentLocale.path}#top`} aria-label="Peanup">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i></span>
      <span>{copy.locale === 'zh-cn' || copy.locale === 'zh-tw' ? <>花生片 <b>Peanup</b></> : 'Peanup'}</span>
    </a>
    <nav aria-label={copy.nav.product}>
      <a href="#product" data-chapter-link="product">{copy.nav.product}</a>
      <a href="#motion" data-chapter-link="motion">{copy.nav.experience}</a>
      <a href="#ecosystem" data-chapter-link="ecosystem">{copy.nav.ecosystem}</a>
      <a href="#play" data-chapter-link="play">{playNavLabel}</a>
      <a href="#technology" data-chapter-link="technology">{copy.nav.technology}</a>
      <a href="#design" data-chapter-link="design">{copy.nav.design}</a>
    </nav>
    <div class="header-actions">
      <a class="header-link" href={docsPath} aria-label={copy.nav.docs}>
        <span class="header-action-label header-action-label--full">{copy.nav.docs}</span>
        <span class="header-action-label header-action-label--short" aria-hidden="true">{mobileDocsLabel}</span>
      </a>
      <details class="language-menu">
        <summary aria-label={copy.nav.language} title={currentLocale.name}>
          <span class="header-action-label header-action-label--full">{currentLocale.name}</span>
          <span class="header-action-label header-action-label--short" aria-hidden="true">{mobileLocaleLabel}</span>
        </summary>
        <div>
          {localeOrder.map((locale) => (
            <a href={localeMeta[locale].path} lang={localeMeta[locale].htmlLang} data-locale-choice={locale} aria-current={locale === copy.locale ? 'page' : undefined}>{localeMeta[locale].name}</a>
          ))}
        </div>
      </details>
      <ThemeToggle locale={copy.locale} />
    </div>
  </header>

  <main id="main-content" class="product-main" tabindex="-1">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title"><span>{heroBrandPrimary}</span>{heroBrandSecondary && <b>{heroBrandSecondary}</b>}</h1>
        <p class="hero-statement">{copy.hero.headline[0]}<br />{copy.hero.headline[1]}</p>
        <p class="hero-lede">{copy.hero.body}</p>
        <div class="hero-cta-row">
          <a class="kickstarter-status" href={campaignPath}><i aria-hidden="true"></i><span>{copy.hero.status}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a>
          <a class="hero-experience-link" href="#motion" data-smooth-anchor><span>{copy.scenes.start}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m0 0-5-5m5 5 5-5" /></svg></a>
        </div>
      </div>

      <figure class="hero-product protected-media" aria-label={copy.hero.imageAlt}>
        <img class="hero-product-preview hero-product-preview--light" src="/assets/peanup-product-preview-light.webp" alt="" width="120" height="182" fetchpriority="high" decoding="sync" draggable="false" />
        <img class="hero-product-preview hero-product-preview--dark" src="/assets/peanup-product-preview-dark.webp" alt="" width="120" height="182" fetchpriority="high" decoding="sync" draggable="false" />
        <picture class="hero-product-image hero-product-image--light" data-progressive-image aria-hidden="true">
          <source srcset="/assets/peanup-product.avif" type="image/avif" />
          <img src="/assets/peanup-product.webp" alt="" width="740" height="1120" fetchpriority="high" decoding="async" draggable="false" />
        </picture>
        <picture class="hero-product-image hero-product-image--dark" data-progressive-image aria-hidden="true">
          <source data-srcset="/assets/peanup-product-cutout.avif" type="image/avif" />
          <img data-src="/assets/peanup-product-cutout.webp" alt="" width="740" height="1120" draggable="false" />
        </picture>
      </figure>

      <div class="hero-object-label" aria-hidden="true"><span>01</span><i></i><p>MAGNETIC<br />E-PAPER OBJECT</p></div>

      <div class="hero-panel-spec" aria-label={copy.hero.specsLabel}>
        <span>3.68”</span>
        <p>E6 SIX-COLOR E-PAPER<br />≈258.7 PPI</p>
        <div class="hero-color-ruler" aria-label={copy.paper.paletteLabel}>
          {paletteValues.map((color) => <i style={`--ruler:${color}`}></i>)}
        </div>
      </div>

      <div class="hero-spec-rail" aria-label={copy.hero.specsLabel}>
        {copy.specRail.map((spec, index) => (
          <a href={index === 4 ? '#hardware' : '#specifications'} data-smooth-anchor aria-label={`${spec.value} ${spec.label}`}>
            <strong>{spec.value}</strong><span>{spec.label}</span>
          </a>
        ))}
      </div>

      <a class="scroll-cue" href="#product" aria-label={copy.nav.product}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m0 0-5-5m5 5 5-5" /></svg>
      </a>
    </section>

    <section id="product" class="manifesto section-pad">
      <div class="section-index"><span>{copy.paper.index}</span><span>{copy.paper.kicker}</span></div>
      <div class="manifesto-copy">
        <h2>{copy.paper.title[0]}<br />{copy.paper.title[1]}</h2>
        <p>{copy.paper.body}</p>
      </div>
      <div class="palette" aria-label={copy.paper.paletteLabel}>
        {copy.paper.pigments.map((pigment, index) => (
          <span style={`--pigment:${paletteValues[index]}`}><canvas width="1" height="1" data-pigment={['black', 'white', 'red', 'yellow', 'blue', 'green'][index]} aria-hidden="true"></canvas><i>{String(index + 1).padStart(2, '0')}</i><b>{pigment}</b><small>{['BLACK', 'PAPER', 'RED', 'YELLOW', 'BLUE', 'GREEN'][index]}</small></span>
        ))}
      </div>
      <div class="paper-proof" role="list" aria-label={copy.paper.kicker}>
        {copy.paper.proofs.map((proof) => (
          <article role="listitem"><span>{proof.label}</span><h3>{proof.title}</h3><p>{proof.body}</p></article>
        ))}
      </div>
    </section>

    <section id="motion" class="ink-gallery" data-phase="rain" aria-label={copy.scenes.tabsLabel}>
      <div class="ink-gallery-stage">
        <div class="ink-gallery-copy">
          <span>{copy.scenes.kicker}</span>
          <h2>{copy.scenes.title[0]}<br />{copy.scenes.title[1]}</h2>
          <p>{copy.scenes.body}</p>
          <ol role="tablist" aria-label={copy.scenes.tabsLabel}>
            {copy.scenes.items.map((scene) => (
              <li
                role="presentation"
                class:list={{ 'ink-more': scene.id === 'experience', active: scene.id === 'rain' }}
              >
                <button
                  id={`ink-scene-tab-${scene.id}`}
                  class:list={['ink-scene-trigger', { active: scene.id === 'rain' }]}
                  type="button"
                  role="tab"
                  data-ink-label={scene.id}
                  data-canvas-heading={scene.canvasHeading}
                  data-canvas-title={scene.canvasTitle}
                  data-canvas-subtitle={scene.canvasSubtitle}
                  data-canvas-meta={scene.canvasMeta}
                  data-canvas-date={scene.date}
                  data-canvas-weather={scene.weather}
                  data-canvas-quote={scene.quote}
                  data-canvas-quote-source={scene.quoteSource}
                  aria-controls="ink-stage-panel"
                  aria-selected={scene.id === 'rain' ? 'true' : 'false'}
                  tabindex={scene.id === 'rain' ? 0 : -1}
                >
                  <i></i><span>{scene.number}</span><strong>{scene.title}</strong><small>{scene.detail}</small>
                </button>
                {scene.id === 'experience' && <div class="ink-more-actions"><button type="button" data-live-start>{copy.scenes.start}</button><a href="#play" data-continue-browsing>{copy.scenes.skip}</a></div>}
              </li>
            ))}
          </ol>
        </div>

        <div class="ink-product" aria-label={copy.hero.imageAlt}>
          <div class="ink-device-shell">
            <div id="ink-stage-panel" class="ink-device-screen" role="tabpanel" aria-labelledby="ink-scene-tab-rain">
              <div id="nature-canvas" class="nature-canvas" aria-hidden="true">
                <div class="ink-canvas-fallback">
                  <div class="ink-fallback-copy">
                    <strong>{copy.scenes.items[0].canvasHeading}</strong>
                    <small>{copy.scenes.items[0].canvasMeta}</small>
                  </div>
                  <div class="ink-fallback-clouds">
                    {paletteValues.map((color) => <i style={`--cloud-color:${color}`}></i>)}
                  </div>
                  <span class="ink-fallback-grain"></span>
                </div>
              </div>
              <span class="ink-screen-material" aria-hidden="true"></span>
              <span class="ink-refresh-line" aria-hidden="true"></span>
              <span class="ink-screen-caption"><b>{copy.scenes.items[0].title} / {copy.scenes.items[0].canvasTitle}</b><i>01 / 04</i></span>
              <div
                class="ink-live-studio"
                data-live-studio
                data-live-intro={copy.scenes.live.intro}
                data-live-ready={copy.scenes.live.ready}
                data-live-text-ready={copy.scenes.live.textReady}
                data-live-error={copy.scenes.live.error}
                data-live-fallback={copy.scenes.live.defaultText}
                aria-label={copy.scenes.live.label}
              >
                <canvas width="528" height="792" data-live-canvas></canvas>
                <div class="ink-live-toolbar">
                  <div class="ink-live-fields">
                    <label class="ink-live-photo" data-live-photo><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-live-file /><span>{copy.scenes.live.drop}</span><small>{copy.scenes.live.local}</small></label>
                    <label class="ink-live-text" data-live-text><span>{copy.scenes.live.prompt}</span><textarea maxlength="120" rows="3" wrap="soft" data-live-input>{copy.scenes.live.defaultText}</textarea></label>
                  </div>
                  <div class="ink-live-footer">
                    <p data-live-status aria-live="polite">{copy.scenes.live.privacy}</p>
                    <output data-live-count aria-live="polite">{[...copy.scenes.live.defaultText].length} / 120</output>
                    <button type="button" class="ink-live-reset" data-live-reset title={copy.scenes.live.reset} aria-label={copy.scenes.live.reset}>
                      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                      <span>{copy.scenes.live.reset}</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <span class="ink-device-name">PEANUP</span>
          </div>
          <div class="ink-product-status"><i></i><span>3.68” / ≈258.7 PPI / E6 SIX-COLOR</span><b>E-PAPER</b></div>
        </div>
      </div>
    </section>

    <section class="photo-band protected-media" data-image-warmup aria-label={copy.life.caption}>
      <picture>
        <source srcset="/assets/peanup-lifestyle.avif" type="image/avif" />
        <img src="/assets/peanup-lifestyle.webp" alt={copy.life.imageAlt} width="1260" height="1674" loading="lazy" decoding="async" draggable="false" />
      </picture>
      <p>{copy.life.title[0]}<br />{copy.life.title[1]}</p>
      <span>{copy.life.caption}</span>
    </section>

    <div class="content-ecosystem-chapter">
    <section id="play" class="playground section-pad">
      <div class="section-index"><span>{copy.content.index}</span><span>{copy.content.kicker}</span></div>
      <div class="play-intro">
        <h2>{copy.content.title[0]}<br />{copy.content.title[1]}</h2>
        <p>{copy.content.body}</p>
      </div>
        <div class="mode-demo">
          <div class="mode-tabs" role="tablist" aria-label={copy.content.modesLabel}>
          {copy.content.modes.map((mode, index) => <button id={`mode-tab-${mode.id}`} role="tab" tabindex={index === 0 ? 0 : -1} aria-selected={index === 0 ? 'true' : 'false'} aria-controls="mode-screen" data-mode={mode.id} data-title={mode.title} data-meta={mode.meta} class:list={{ active: index === 0 }}>{mode.label}</button>)}
        </div>
        <div class="device-stage">
          <div class="device-shell"><div id="mode-screen" class="device-screen screen-photo" role="tabpanel" aria-labelledby={`mode-tab-${copy.content.modes[0].id}`} aria-live="polite"><div class="screen-art" aria-hidden="true"><i></i><i></i><i></i></div><span id="screen-meta">{copy.content.modes[0].meta}</span><strong id="screen-title">{copy.content.modes[0].title}</strong></div><span class="device-name">PEANUP</span></div>
          <div class="send-status"><i></i><span>Bluetooth</span><b>Ready</b></div>
        </div>
        <ol class="workflow">
          {copy.content.workflow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step.title}</strong><p>{step.body}</p></li>)}
        </ol>
      </div>
      <div class="mode-open-note">
        <span aria-hidden="true">…</span>
        <div><strong>{copy.content.more.title}</strong><p>{copy.content.more.body}</p></div>
      </div>
      <a class="content-guide-link" href={contentPath}>{copy.content.guideCta}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a>
    </section>

    <section id="ecosystem" class="apple-ecosystem section-pad">
      <span id="ecosystem-library" class="apple-anchor" aria-hidden="true"></span>
      <div class="section-index"><span>{copy.ecosystem.index}</span><span>{copy.ecosystem.kicker}</span></div>
      <div class="apple-head"><div><span>PEANUP / iOS</span><h2><span>{copy.ecosystem.title[0]}</span>{' '}<span>{copy.ecosystem.title[1]}</span></h2></div><p>{copy.ecosystem.body}</p></div>
      <div class="apple-stage" data-image-warmup>
        <div class="shortcut-phone" data-phone-gesture aria-label={`${copy.ecosystem.kicker}. ${copy.ecosystem.title.join(' ')}`}>
          <div
            class="iphone-device iphone-17-pro iphone-17-pro--black"
            data-phone-device
            data-state="compose"
            data-device-size="71.9x150.0x8.75mm"
            data-frame-ratio="71.9/150"
            data-frame-asset-ratio="662/1380"
            data-frame-asset="iphone-17-pro-frame.png"
            data-display-ratio="1206/2622"
            data-display-points="402x874"
            data-display-ppi="460"
            data-status-bar-points="402x62"
            data-status-bar-height="0.070938"
            data-status-frame="0x0x402x62"
            data-status-visible-bounds="193x66x880x40"
            data-screen-frame="28x35x606x1310"
            data-island-frame="138x14x126x37"
            role="img"
            aria-label="Black iPhone 17 Pro app preview, proportioned to the 71.9 by 150 by 8.75 millimetre body with a calibrated display opening"
          >
            <div class="iphone-glass">
              <div
                class="iphone-statusbar"
                data-status-source="iphone-17-pro-status-png"
                aria-hidden="true"
              >
                <img
                  class="iphone-status-image protected-media"
                  src="/assets/iphone-17-pro-status.png"
                  width="1056"
                  height="163"
                  loading="eager"
                  decoding="sync"
                  fetchpriority="high"
                  draggable="false"
                  alt=""
                />
                <span class="iphone-status-fallback" aria-hidden="true">
                  <time>9:41</time>
                </span>
              </div>
              <div class="shortcut-screen" data-phone-screen data-state="compose">
                <header class="peanup-app-header">
                  <span class="phone-ui-button" aria-hidden="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                  </span>
                  <strong class="peanup-app-title">PEANUP</strong>
                  <div class="peanup-app-actions">
                    <small data-phone-status aria-live="polite">{phoneStates[0].feature.title}</small>
                    <span class="phone-ui-button" aria-hidden="true">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.35-5.65L4 8.7M4 4v4.7h4.7" /><path d="M12 8v4l2.8 1.7" /></svg>
                    </span>
                    <span class="phone-ui-button" aria-hidden="true">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.2 1.8 2.2.5.3 2.2 1.8 1.2-.8 2.1.8 2.1-1.8 1.2-.3 2.2-2.2.5L12 21l-1.2-1.8-2.2-.5-.3-2.2-1.8-1.2.8-2.1-.8-2.1 1.8-1.2.3-2.2 2.2-.5L12 3Z" /><circle cx="12" cy="12" r="2.6" /></svg>
                    </span>
