                <p>{item.body}</p>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg>
              </a>
            ))}
          </div>
          <div class="specification-foot">
            <a href={`${docsPath}#specifications`}>{specificationDocLabel}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a>
            <a href={campaignPath}>{copy.story.actions.campaign}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a>
          </div>
        </section>
      </div>
    </section>

    <div class="brand-chapter">
