          {technologyChapters.map((label, index) => (
            <a href={['#technology', '#dithering', '#hardware', '#specifications'][index]}>
              <i>{String(index + 1).padStart(2, '0')}</i><span>{label}</span>
            </a>
          ))}
        </nav>
        <ol class="image-pipeline" data-epaper-pipeline>
          {copy.technology.pipeline.map((step, index) => (
            <li>
              <span>{step.label}</span>
              {index === 0 && <div class="pipeline-visual pipeline-source protected-media"><picture><source srcset="/assets/peanup-anime-source.avif" type="image/avif" /><source srcset="/assets/peanup-anime-source.webp" type="image/webp" /><img src="/assets/peanup-anime-source.jpg" alt={copy.technology.pipeline[0].title} width="500" height="500" loading="lazy" decoding="async" draggable="false" /></picture></div>}
              {index === 1 && <div class="pipeline-visual pipeline-canvas" data-epaper-output><picture class="pipeline-canvas-fallback protected-media" aria-hidden="true"><source srcset="/assets/peanup-anime-source.avif" type="image/avif" /><source srcset="/assets/peanup-anime-source.webp" type="image/webp" /><img src="/assets/peanup-anime-source.jpg" alt="" width="500" height="500" loading="lazy" decoding="async" draggable="false" /></picture><canvas id="epaper-preview" data-epaper-preview aria-label={copy.technology.pipeline[1].title}></canvas><i data-epaper-mode-label aria-live="polite">FLOYD–STEINBERG</i></div>}
