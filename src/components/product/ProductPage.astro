              {index === 3 && <div class="pipeline-visual pipeline-device"><div class="protected-media"><picture><source srcset="/assets/peanup-lifestyle.avif" type="image/avif" /><img src="/assets/peanup-lifestyle.webp" alt={copy.life.imageAlt} width="1260" height="1674" loading="lazy" decoding="async" draggable="false" /></picture><i></i></div><b>PEANUP</b></div>}
              <h3>{step.title}</h3><p>{step.body}</p>
            </li>
          ))}
        </ol>

