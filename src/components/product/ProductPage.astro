            <div class="dynamic-island" aria-hidden="true">
              <span class="dynamic-island-progress"><b></b><small>68%</small></span>
              <i class="dynamic-island-camera"></i>
              <i class="dynamic-island-sensor"></i>
            </div>
          </div>
        </div>
        <div class="apple-journey" role="tablist" aria-label={copy.ecosystem.kicker}>
          {phoneStates.map((state, index) => (
            <button
              id={`phone-state-${state.id}`}
              type="button"
              role="tab"
              data-phone-state={state.id}
              data-phone-title={state.feature.title}
              aria-label={`${String(index + 1).padStart(2, '0')} ${state.feature.title}`}
              aria-controls={`phone-view-${state.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              class:list={{ active: index === 0 }}
            >
              <span aria-hidden="true" data-phone-step={String(index + 1).padStart(2, '0')}>{state.label}</span><strong aria-hidden="true" data-phone-mobile-title={phoneMobileTitles[index]}>{state.feature.title}</strong><small aria-hidden="true">{state.feature.body}</small>
            </button>
          ))}
        </div>
        <div class="apple-platforms">
          {platformFeatures.map((feature) => <article><span>{feature.label}</span><h3>{feature.title}</h3><p>{feature.body}</p></article>)}
        </div>
      </div>

      <section id="automation" class="automation-story" aria-labelledby="automation-title">
        <div class="automation-story-head">
          <span>{copy.ecosystem.automation.label}</span>
          <h3 id="automation-title">{copy.ecosystem.automation.title[0]}<br />{copy.ecosystem.automation.title[1]}</h3>
          <p>{copy.ecosystem.automation.body}</p>
        </div>
        <ol class="automation-timeline" aria-label={copy.ecosystem.automation.momentsLabel}>
          {copy.ecosystem.automation.moments.map((moment, index) => (
            <li>
              <button
                type="button"
                class:list={{ active: index === 0 }}
                data-automation-example
                data-automation-time={moment.time}
                data-automation-title={moment.title}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <time>{moment.time}</time>
                <span>{moment.label}</span>
                <strong>{moment.title}</strong>
                <small>{moment.body}</small>
              </button>
            </li>
          ))}
        </ol>
        <div class="automation-story-foot">
          <p>{copy.ecosystem.automation.note}</p>
          <a href={shortcutsPath}>
            <span>{copy.ecosystem.automation.cta}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg>
          </a>
        </div>
      </section>
    </section>
