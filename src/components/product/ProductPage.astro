      <figure class="detail-photo detail-hand protected-media"><img class="detail-photo-preview" src="/assets/peanup-hand-preview.webp" alt="" width="180" height="225" loading="eager" decoding="sync" fetchpriority="low" draggable="false" aria-hidden="true" /><picture data-progressive-image><source data-srcset="/assets/peanup-hand.avif" type="image/avif" /><img data-src="/assets/peanup-hand.webp" alt={copy.design.handAlt} width="1122" height="1402" loading="lazy" decoding="async" fetchpriority="low" draggable="false" /></picture><figcaption>{copy.design.light}</figcaption></figure>
    </section>

    <section id="story" class="story section-pad">
      <div class="wordmark" aria-hidden="true">PEANUP</div>
      <div class="story-grid"><h2>{copy.story.title[0]}<br />{copy.story.title[1]}</h2><div><p>{copy.story.body}</p><span>{copy.story.status}</span><nav class="story-actions" aria-label={copy.story.status}><a href={docsPath}><span>{copy.story.actions.docs}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a><a href={campaignPath}><span>{copy.story.actions.campaign}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a><a href="mailto:i@caiths.com"><span>{copy.story.actions.contact}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg></a></nav></div></div>
