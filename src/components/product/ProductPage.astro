  </main>

  <footer>
    <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><i></i><i></i></span><span>{isChineseLocale ? <>花生片 <b>Peanup</b></> : 'Peanup'}</span></a>
    <div class="footer-links"><a href="mailto:i@caiths.com">i@caiths.com</a><a href="https://github.com/poboll/peanup-web" target="_blank" rel="noreferrer">GitHub</a><a href={docsPath}>{copy.footer.docs}</a><a href={troubleshootingPath}>{troubleshootingLabel}</a><a href={supportPath}>{copy.footer.support}</a><a href={privacyPath}>{copy.footer.privacy}</a></div>
    <span>© 2026 PEANUP</span>
  </footer>

  <script>
    import '../../scripts/site';
    import '../../scripts/lazyFeatures';
