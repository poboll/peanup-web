---
import BaseLayout from '../layouts/BaseLayout.astro';

const modes = [
  { id: 'photo', label: '照片', title: '把今天，留在纸上', meta: 'PHOTO / 16:24', className: 'screen-photo' },
  { id: 'calendar', label: '日历', title: '七月廿七', meta: 'SUNDAY / 27', className: 'screen-calendar' },
  { id: 'weather', label: '天气', title: '阵雨转晴', meta: 'SHENZHEN / 28°', className: 'screen-weather' },
  { id: 'quote', label: '书摘', title: '日子自有它的纹理', meta: 'READING / 08:40', className: 'screen-quote' },
];
---

<BaseLayout
  title="花生片 Peanup｜4 寸六色蓝牙墨水屏"
  description="花生片 Peanup 是一块正在打磨中的 4 寸六色蓝牙电子墨水屏，把照片、日历、天气与书摘留在冰箱和桌面。"
>
  <header class="site-header" aria-label="网站导航">
    <a class="brand" href="#top" aria-label="花生片 Peanup 首页">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i></span>
      <span>花生片 <b>Peanup</b></span>
    </a>
    <nav>
      <a href="#product">产品</a>
      <a href="#play">玩法</a>
      <a href="#technology">技术</a>
      <a href="#design">设计</a>
      <a href="/docs/">文档</a>
    </nav>
    <a class="header-link" href="/docs/">开放文档</a>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">花生片<br /><span>Peanup</span></h1>
        <p>把喜欢的画面，<br />留在冰箱上。</p>
      </div>

      <div class="hero-product" aria-label="花生片产品展示">
        <picture>
          <source srcset="/assets/peanup-product.avif" type="image/avif" />
          <img src="/assets/peanup-product.webp" alt="白色相纸造型的六色电子墨水屏" width="720" height="1020" fetchpriority="high" />
        </picture>
        <span class="product-shadow" aria-hidden="true"></span>
      </div>

      <div class="hero-object-label" aria-hidden="true"><span>01</span><i></i><p>MAGNETIC<br />E-PAPER OBJECT</p></div>

      <div class="hero-color-ruler" aria-label="六色电子墨水色板">
        <i style="--ruler:#161616"></i><i style="--ruler:#f4f1e8"></i><i style="--ruler:#d64737"></i><i style="--ruler:#e7b62f"></i><i style="--ruler:#3f71b8"></i><i style="--ruler:#6d9a63"></i>
        <span>SPECTRA 6</span>
      </div>

      <div class="hero-spec" aria-label="核心特性">
        <span>4.0”</span>
        <p>六色电子墨水屏<br />蓝牙无线传图</p>
      </div>

      <div class="hero-facts" aria-label="花生片产品摘要">
        <div><span>DISPLAY</span><strong>4.0” 六色电子纸</strong></div>
        <div><span>TRANSFER</span><strong>CoreBluetooth 近场传图</strong></div>
        <div><span>FORM</span><strong>冰箱贴 · 桌面 · 随身</strong></div>
      </div>

      <a class="scroll-cue" href="#product" aria-label="向下查看产品">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m0 0-5-5m5 5 5-5" /></svg>
      </a>
    </section>

    <section id="product" class="manifesto section-pad">
      <div class="section-index"><span>01</span><span>不发光，也醒目</span></div>
      <div class="manifesto-copy">
        <h2>不是又一块屏幕。<br />是一张会更新的纸。</h2>
        <p>花生片用六种颜色还原照片的层次与颗粒。没有刺眼背光，阳光越充足，画面越清楚。它安静地待在冰箱、书桌或墙面，直到下一张喜欢的画面到来。</p>
      </div>
      <div class="palette" aria-label="六色电子墨水色板">
        <span style="--ink:#161616"><i>01</i><b>墨</b><small>BLACK</small></span>
        <span style="--ink:#f4f1e8"><i>02</i><b>纸</b><small>WHITE</small></span>
        <span style="--ink:#d64737"><i>03</i><b>朱</b><small>RED</small></span>
        <span style="--ink:#e7b62f"><i>04</i><b>黄</b><small>YELLOW</small></span>
        <span style="--ink:#3f71b8"><i>05</i><b>蓝</b><small>BLUE</small></span>
        <span style="--ink:#6d9a63"><i>06</i><b>绿</b><small>GREEN</small></span>
      </div>
    </section>

    <section id="motion" class="ink-gallery" data-phase="rain" aria-label="花生片屏幕内容：雨帘、花枝与飞燕">
      <div class="ink-gallery-stage">
        <div class="ink-gallery-copy">
          <span>SCREEN STUDY / 01—03</span>
          <h2>世界继续流动，<br />喜欢的这一帧留下来。</h2>
          <p>随手拍下眼前的风景，发送到花生片。刷新结束后，画面安静地定格在电子纸上。</p>
          <ol aria-label="屏幕内容进度">
            <li data-ink-label="rain"><i></i><span>01</span><strong>六色雨帘</strong><small>48 条 · 随滚动放卷</small></li>
            <li data-ink-label="branch"><i></i><span>02</span><strong>五条花枝</strong><small>生长 · 分叉 · 开花</small></li>
            <li data-ink-label="bird"><i></i><span>03</span><strong>三十只飞燕</strong><small>弧线 · 扑翼 · 叉尾</small></li>
            <li class="ink-more"><i></i><span>…</span><strong>还有更多</strong><small>照片 · 日历 · 天气 · 灵感</small></li>
          </ol>
        </div>

        <div class="ink-product" aria-label="正在播放自然画面的花生片墨水屏">
          <div class="ink-device-shell">
            <div class="ink-device-screen">
              <div id="nature-canvas" class="nature-canvas" aria-hidden="true"></div>
              <span class="ink-screen-grain" aria-hidden="true"></span>
              <span class="ink-screen-caption"><b>RAIN CURTAIN</b><i>01 / 03</i></span>
            </div>
            <span class="ink-device-name">PEANUP</span>
          </div>
          <div class="ink-product-status"><i></i><span>4.0” SIX-COLOR E-PAPER</span><b>SCROLL TO CHANGE</b></div>
        </div>
      </div>
    </section>

    <section class="photo-band" aria-label="花生片随身使用场景">
      <picture>
        <source srcset="/assets/peanup-lifestyle.avif" type="image/avif" />
        <img src="/assets/peanup-lifestyle.webp" alt="花生片挂在浅色背包上的使用场景" width="1260" height="1674" loading="lazy" />
      </picture>
      <p>一小片日常，<br />随处安放。</p>
      <span>MAGNETIC E-PAPER OBJECT</span>
    </section>

    <section id="play" class="playground section-pad">
      <div class="section-index"><span>02</span><span>每天都能换一种表达</span></div>
      <div class="play-intro">
        <h2>蓝牙轻轻一传，<br />画面就留了下来。</h2>
        <p>选择内容，预览六色效果，再发送到花生片。无需让屏幕一直亮着，更新之后，它自己记住这一刻。</p>
      </div>

      <div class="mode-demo">
        <div class="mode-tabs" role="tablist" aria-label="内容模式">
          {modes.map((mode, index) => (
            <button
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls="mode-screen"
              data-mode={mode.id}
              data-title={mode.title}
              data-meta={mode.meta}
              class:list={{ active: index === 0 }}
            >{mode.label}</button>
          ))}
        </div>

        <div class="device-stage">
          <div class="device-shell">
            <div id="mode-screen" class="device-screen screen-photo" role="tabpanel" aria-live="polite">
              <div class="screen-art" aria-hidden="true"><i></i><i></i><i></i></div>
              <span id="screen-meta">PHOTO / 16:24</span>
              <strong id="screen-title">把今天，留在纸上</strong>
            </div>
            <span class="device-name">PEANUP</span>
          </div>
          <div class="send-status"><i></i><span>Bluetooth</span><b>Ready</b></div>
        </div>

        <ol class="workflow" aria-label="蓝牙传图步骤">
          <li><span>01</span><strong>选择</strong><p>照片或日常卡片</p></li>
          <li><span>02</span><strong>预览</strong><p>六色纸感效果</p></li>
          <li><span>03</span><strong>发送</strong><p>蓝牙更新画面</p></li>
        </ol>
      </div>
    </section>

    <section class="capabilities section-pad" aria-labelledby="capability-title">
      <div class="section-index"><span>03</span><span>从相机到日常信息</span></div>
      <div class="capability-head">
        <h2 id="capability-title">不只换一张照片。<br />也换一种看时间的方式。</h2>
        <p>从随手拍下的照片，到每天想看见的信息，花生片把不同内容变成一张张有纸感的画面。</p>
      </div>
      <div class="capability-list">
        <article><span>01</span><h3>相机与相册</h3><p>拍摄、导入、定比裁切与六色实时预览。</p></article>
        <article><span>02</span><h3>双重曝光</h3><p>把两次取景叠成一张带偶然感的电子相纸。</p></article>
        <article><span>03</span><h3>时间进度</h3><p>年、季度、月与周，变成每天可见的刻度。</p></article>
        <article><span>04</span><h3>天气卡片</h3><p>让今天的温度、天气与地点成为一幅日常画面。</p></article>
        <article><span>05</span><h3>微信读书书摘</h3><p>把喜欢的句子排成一张值得反复阅读的卡片。</p></article>
        <article><span>06</span><h3>相纸画廊</h3><p>收藏拍下与制作过的画面，随时再次发送。</p></article>
        <article><span>07</span><h3>自动显影</h3><p>拍下之后自动处理、连接并发送，减少操作步骤。</p></article>
        <article><span>08</span><h3>传输进度</h3><p>在 App、锁屏和灵动岛查看画面更新状态。</p></article>
      </div>
    </section>

    <section id="technology" class="technology" aria-labelledby="technology-title">
      <div class="tech-inner">
        <div class="section-index"><span>04</span><span>一张图，怎样变成电子纸</span></div>
        <div class="tech-head">
          <h2 id="technology-title">计算留在手机，<br />画面留在纸上。</h2>
          <p>照片在手机本地完成裁切、调色和六色处理，再通过蓝牙近场发送。刷新之后，电子纸无需持续发光也能保持画面。</p>
        </div>

        <ol class="image-pipeline" aria-label="图片到电子墨水屏的处理流程">
          <li><span>01 / INPUT</span><div class="pipeline-visual source-grid" aria-hidden="true"><i></i></div><h3>整理画面</h3><p>校正方向，按设备比例裁切，再缩放到屏幕像素规格。</p></li>
          <li><span>02 / COLOR</span><div class="pipeline-visual dither-grid" aria-hidden="true"></div><h3>六色成像</h3><p>压缩明暗层次，匹配黑、白、黄、红、蓝、绿，并选择合适的抖动方式。</p></li>
          <li><span>03 / BLE</span><div class="pipeline-visual packet-line" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div><h3>分块传输</h3><p>连接设备、读取能力、协商分块大小，按确认节奏发送像素数据。</p></li>
          <li><span>04 / DISPLAY</span><div class="pipeline-visual epaper-flash" aria-hidden="true"><i></i></div><h3>刷新并确认</h3><p>等待设备最终确认和刷新结果，异常时保留任务，方便再次发送。</p></li>
        </ol>

        <section class="dither-studio" aria-labelledby="dither-title">
          <div class="dither-intro">
            <span>RENDER ENGINE / SIX COLOR</span>
            <h3 id="dither-title">不是一种滤镜，<br />是按内容选择的抖动系统。</h3>
            <p>实时预览优先稳定和速度，最终写屏再使用更精细的感知选色。算法输出六色索引，随后才进入半字节打包与蓝牙传输。</p>
          </div>
          <div class="dither-presets">
            <article><span>REALTIME</span><strong>Ordered 4×4 / 8×8</strong><p>Bayer 阈值与预计算调色板，适合相机实时预览，帧间稳定。</p><i class="dither-sample ordered" aria-hidden="true"></i></article>
            <article><span>BALANCED</span><strong>Floyd-Steinberg / Stucki</strong><p>蛇形向量误差扩散，兼顾细节、速度与六色噪点控制。</p><i class="dither-sample diffusion" aria-hidden="true"></i></article>
            <article><span>PHOTO</span><strong>感知量化 / Spectra Mix</strong><p>使用设备调色板、色调映射与局部混色，为最终照片保留层次。</p><i class="dither-sample spectra" aria-hidden="true"></i></article>
          </div>
          <div class="algorithm-index" aria-label="支持与规划的抖动算法">
            <span>Floyd-Steinberg</span><span>False Floyd</span><span>Atkinson</span><span>Jarvis-Judice-Ninke</span><span>Stucki</span><span>Burkes</span><span>Sierra 3</span><span>Sierra 2</span><span>Sierra Lite</span><span>Ordered 4×4</span><span>Ordered 8×8</span><span>Quantization Only</span>
          </div>
        </section>

        <div class="architecture" aria-label="花生片第一版技术架构">
          <div class="architecture-title"><span>LOCAL-FIRST ARCHITECTURE</span><h3>一条短而清楚的路径</h3></div>
          <div class="architecture-flow">
            <span>iPhone / iPad</span><i aria-hidden="true"></i><span>图像处理</span><i aria-hidden="true"></i><span>传输协调</span><i aria-hidden="true"></i><span>CoreBluetooth</span><i aria-hidden="true"></i><span>花生片</span>
          </div>
          <p>相机、导入、图像处理、画廊与待发送任务都可离线工作。连接时先发现服务与设备能力，再决定数据格式和发送节奏。</p>
        </div>

        <section class="hardware-path" aria-labelledby="hardware-title">
          <div class="hardware-head">
            <span>HARDWARE PATH</span>
            <h3 id="hardware-title">静态时安静，<br />需要时才连接。</h3>
            <p>电子纸只在更换画面时刷新。平时不发光、不打扰，让照片和信息像一张真正的纸留在身边。</p>
          </div>
          <div class="hardware-grid">
            <article><span>01 / BLE</span><h4>低功耗蓝牙</h4><p>靠近即可发送照片与卡片，完成刷新后回到安静的低功耗状态。</p></article>
            <article><span>02 / NFC</span><h4>CUID NFC</h4><p>兼容部分支持 CUID 的公司和物业门禁系统，让一张卡片多一种用途。</p></article>
            <article><span>03 / POWER</span><h4>Qi 无线充电</h4><p>无需外露充电接口，放下即可补充电量，保持完整简洁的外观。</p></article>
            <article><span>04 / MAGNET</span><h4>磁吸摆放</h4><p>吸附在冰箱、手机背面或磁吸支架上，把喜欢的画面带到不同位置。</p></article>
          </div>
        </section>
      </div>
    </section>

    <section id="design" class="details section-pad">
      <div class="section-index light"><span>05</span><span>让科技留一点温度</span></div>
      <div class="details-head">
        <h2>看起来像相纸，<br />用起来更自由。</h2>
        <p>白色框体把电子纸变成一件可以触摸、摆放和搭配的日常物件。我们仍在认真打磨它的每一道边缘。</p>
      </div>
      <div class="detail-photo detail-phone">
        <picture>
          <source srcset="/assets/peanup-phone.avif" type="image/avif" />
          <img src="/assets/peanup-phone.webp" alt="花生片与手机搭配展示" width="1080" height="1320" loading="lazy" />
        </picture>
      </div>
      <div class="detail-photo detail-hand">
        <picture>
          <source srcset="/assets/peanup-hand.avif" type="image/avif" />
          <img src="/assets/peanup-hand.webp" alt="手持花生片放入包袋" width="1080" height="1320" loading="lazy" />
        </picture>
      </div>
      <div class="detail-note"><span>4 inch</span><p>一块适合照片与信息卡片的画面尺寸。</p></div>
    </section>

    <section id="story" class="story section-pad">
      <div class="wordmark" aria-hidden="true">PEANUP</div>
      <div class="story-grid">
        <h2>Peanut 的可爱，<br />加一点 Up 的活力。</h2>
        <div>
          <p>“花生片”是一块小而有生命力的电子纸。我们希望技术不用总是显得冷硬，也可以像一张照片、一句随手记下的话，成为生活里轻轻向上的提醒。</p>
          <span>花生片 Peanup · Coming soon on Kickstarter</span>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><i></i><i></i></span><span>花生片 <b>Peanup</b></span></a>
    <div class="footer-links"><a href="mailto:i@caiths.com">i@caiths.com</a><a href="https://github.com/poboll/peanup-web" target="_blank" rel="noreferrer">GitHub</a><a href="/docs/">开放文档</a></div>
    <span>© 2026 PEANUP</span>
  </footer>

  <script>
    import '../scripts/site';
    import '../scripts/heroSketch';
  </script>
</BaseLayout>
